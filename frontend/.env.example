VITE_PRIVY_APP_ID=your-privy-app-id-here

# Full URL of the backend, no trailing slash. LEAVE EMPTY in local dev — Vite's
# proxy at vite.config.js sends `/api/*` to localhost:8787. Set in production
# (Vercel) to the Render backend origin, e.g. https://trustramp-backend.onrender.com
VITE_API_BASE_URL=

# Must exactly match API_SHARED_SECRET in backend/.env — see the comment
# above requireSharedSecret() in backend/server.js for what this does and
# does not protect against (it's a stopgap, not real user authentication).
VITE_API_SHARED_SECRET=replace-with-a-long-random-string

# Not read directly by code — these go into the bundler/paymaster URL you
# configure in the Privy Dashboard (Settings -> Smart Wallets -> X Layer
# Testnet custom chain). Kept here so they're not lost between sessions.
#
# Provider is ALCHEMY, not thirdweb: thirdweb's bundler rejects X Layer
# outright (`Invalid chain: 1952`), which caused the getAddress "0x" error.
# Alchemy's bundler is verified working on 1952. Get a key at alchemy.com.
# Bundler/paymaster URL: https://xlayer-testnet.g.alchemy.com/v2/<API_KEY>
# ALCHEMY_API_KEY_FOR_PRIVY_DASHBOARD=your-alchemy-api-key-here

# --- Alchemy AA config ---
#
# READ THIS BEFORE ASSUMING THESE ARE WIRED UP IN CODE.
#
# VITE_ALCHEMY_BUNDLER_URL is NOT read by any code, and cannot be. Privy's
# SmartWalletsProvider only accepts `{ paymasterContext }` — bundlerUrl and
# paymasterUrl live inside Privy's internal signerToSmartAccountClient and are
# populated from the PRIVY DASHBOARD, not from the app bundle. Verified against
# node_modules/@privy-io/react-auth/dist/dts/smart-wallets.d.ts. This value is
# recorded here only so the dashboard setting has a source of truth in the repo.
# If the dashboard bundler field is left blank, Privy falls back to Pimlico's
# public bundler, which returns `chain "1952" is not supported`.
VITE_ALCHEMY_BUNDLER_URL=https://xlayer-testnet.g.alchemy.com/v2/your-alchemy-api-key-here

# The Alchemy Gas Manager policy ID is deliberately NOT stored here. It lives in
# the Privy dashboard only. Passing it from code (as SmartWalletsProvider's
# paymasterContext.policyId) would override the dashboard value, letting the two
# drift out of sync silently. Dashboard is the single source of truth.
