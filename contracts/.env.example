# Copy to .env. NEVER commit .env — it is gitignored, verify before committing.
#
# Generate a burner deployer wallet with:  npm run new-wallet
# That writes DEPLOYER_PRIVATE_KEY here automatically and never transmits it.
#
# TESTNET ONLY. Never put a key holding real funds in this file.
# Whoever deploys becomes the contract owner, and owner is the only address
# that can call recordGraduation — so this key becomes your admin key.
DEPLOYER_PRIVATE_KEY=

# Optional RPC overrides. Defaults in hardhat.config.js are OKX's public
# endpoints; override only if those are congested.
# XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech/terigon
# XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
