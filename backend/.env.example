# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=8787
# Origin allowed to call this backend. Defaults to the Vite dev server if unset.
ALLOWED_ORIGIN=http://localhost:5173

# Shared secret the frontend must send in the X-TrustRamp-Secret header.
# This is a STOPGAP, not real user authentication — see the comment above
# requireSharedSecret() in server.js for exactly what it does and doesn't
# protect against. Generate any long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match VITE_API_SHARED_SECRET in frontend/.env exactly.
API_SHARED_SECRET=replace-with-a-long-random-string

# --- Day 7-8: reputation score wiring ---
#
# The same key that deployed TrustRampReputation. This backend is the ONLY
# signer for recordGraduation; a compromise means an attacker can mint any score
# for anyone. Treat as a production credential.
DEPLOYER_PRIVATE_KEY=0x...

# Deployed on X Layer testnet, chain 1952. See contracts/deployments/xlayerTestnet.json
# for the canonical, machine-generated record.
REPUTATION_ADDRESS=0x...
CONSUMER_ADDRESS=0x...
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech/terigon

# --- Day 11-12: mainnet bundler proxy ---
#
# Alchemy bundler URL for X Layer Mainnet (chain 196).
# App: "tramp 2 (mainnet)", Gas Policy ID: c285838d-b936-4dca-afbf-28f4acd1f4e2
# Used by /api/bundler-mainnet. Must also be set on Render's environment variables.
ALCHEMY_BUNDLER_URL_MAINNET=https://...
